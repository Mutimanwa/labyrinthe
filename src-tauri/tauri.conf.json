{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LABYRINTHE",
  "version": "0.1.0",
  "identifier": "bi.academie.labyrinthe",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LABYRINTHE",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "resources": ["../content"],
    "category": "Game",
    "shortDescription": "Simulation de hacking pédagogique — du terminal au white hat",
    "longDescription": "LABYRINTHE est une simulation close de cybersécurité : reconnaissance, exploitation, post-exploitation et défense, dans un monde fictif entièrement simulé. Aucune interaction avec le système réel."
  }
}
